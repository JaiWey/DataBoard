{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=databoard;Username=databoard;Password=CHANGE_ME_USE_USER_SECRETS"
  },
  "Jwt": {
    "Issuer": "DataBoard",
    "Audience": "DataBoard",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "DataSourceSecurity": {
    "AllowPrivateNetworks": false
  },
  "Uploads": {
    "Path": "App_Data/uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
