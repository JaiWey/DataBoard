#!/bin/bash
# Runs once, when the server is first made (cloud-init), as root. Log: /var/log/databoard-bootstrap.log
# It prepares the machine: a data disk, the Caddy web server (HTTPS), and the scripts deploy.ps1 uses to put a release in
# place. The application itself arrives with the first deploy.
set -euxo pipefail
exec > >(tee /var/log/databoard-bootstrap.log) 2>&1

# 1 GB of swap: a 1 GB server needs room to spare while it unpacks a release.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# libicu: the self-contained application brings .NET with it, but not the Unicode library it uses for culture-aware text.
dnf install -y libicu tar gzip

id databoard >/dev/null 2>&1 || useradd --system --home-dir /opt/databoard --shell /sbin/nologin databoard
id caddy >/dev/null 2>&1 || useradd --system --home-dir /opt/databoard/data/caddy --shell /sbin/nologin caddy
mkdir -p /opt/databoard/releases /etc/databoard /etc/caddy

# The data disk: made into a file system the first time, mounted every time.
DEVICE=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id}
for i in $(seq 1 150); do
  [ -e "$DEVICE" ] && break
  sleep 2
done
if ! blkid "$DEVICE"; then
  mkfs -t xfs "$DEVICE"
fi
mkdir -p /opt/databoard/data
UUID=$(blkid -s UUID -o value "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /opt/databoard/data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /opt/databoard/data/uploads /opt/databoard/data/keys /opt/databoard/data/caddy
chown -R databoard:databoard /opt/databoard/data/uploads /opt/databoard/data/keys
chown -R caddy:caddy /opt/databoard/data/caddy

# ---- Caddy: the web server that gets and renews the certificate and passes requests on to the application ----------
curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v${caddy_version}/caddy_${caddy_version}_linux_${caddy_arch}.tar.gz" -o /tmp/caddy.tgz
tar -xzf /tmp/caddy.tgz -C /usr/local/bin caddy
chmod 755 /usr/local/bin/caddy

cat > /etc/caddy/Caddyfile <<'EOC'
{
%{ if email != "" ~}
  email ${email}
%{ endif ~}
}

${host} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8080
}
EOC

cat > /etc/systemd/system/caddy.service <<'EOU'
[Unit]
Description=Caddy web server (HTTPS for DataBoard)
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
# Certificates and Caddy's own settings live on the data disk, so a new server keeps them.
Environment=XDG_DATA_HOME=/opt/databoard/data/caddy
Environment=XDG_CONFIG_HOME=/opt/databoard/data/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOU

# ---- the application: a systemd service running the self-contained build --------------------------------------------
cat > /etc/systemd/system/databoard.service <<'EOU'
[Unit]
Description=DataBoard
After=network-online.target
Wants=network-online.target

[Service]
User=databoard
Group=databoard
WorkingDirectory=/opt/databoard/app
ExecStart=/opt/databoard/app/DataBoard.Server
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
Environment=Database__MigrateOnStartup=true
Environment=Uploads__Path=/opt/databoard/data/uploads
Environment=DataProtection__KeysPath=/opt/databoard/data/keys
Environment=DOTNET_GCConserveMemory=5
Environment=DOTNET_NOLOGO=1
# The database password, the token key and the like: written from Parameter Store by configure.sh, readable by root only.
EnvironmentFile=/etc/databoard/databoard.env
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOU

# Fetches the secret settings into the file the service reads. Run again by release.sh, so a changed setting needs only a deploy.
cat > /opt/databoard/configure.sh <<'EOS'
#!/bin/bash
set -euo pipefail
REGION=${region}
PARAM=${param_prefix}
get() { aws ssm get-parameter --region "$REGION" --with-decryption --name "$1" --query Parameter.Value --output text; }

umask 077
{
  echo "ConnectionStrings__Default=$(get $PARAM/db-connection-string)"
  echo "Jwt__Key=$(get $PARAM/jwt-key)"
%{ if github_enabled ~}
  echo "Authentication__GitHub__ClientId=$(get $PARAM/github-client-id)"
  echo "Authentication__GitHub__ClientSecret=$(get $PARAM/github-client-secret)"
%{ endif ~}
} > /etc/databoard/databoard.env.new
chown root:root /etc/databoard/databoard.env.new
mv /etc/databoard/databoard.env.new /etc/databoard/databoard.env
EOS

# Puts a release in place and (re)starts the application: release.sh s3://bucket/releases/<name>.tgz
cat > /opt/databoard/release.sh <<'EOS'
#!/bin/bash
set -euo pipefail
SOURCE="$1"
REGION=${region}
STAMP=$(date +%Y%m%d%H%M%S)
RELEASE=/opt/databoard/releases/$STAMP

mkdir -p "$RELEASE"
aws s3 cp --region "$REGION" "$SOURCE" /tmp/release.tgz
tar -xzf /tmp/release.tgz -C "$RELEASE"
rm -f /tmp/release.tgz
chmod 755 "$RELEASE/DataBoard.Server"

/opt/databoard/configure.sh
ln -sfn "$RELEASE" /opt/databoard/app
systemctl daemon-reload
systemctl enable databoard caddy >/dev/null 2>&1
systemctl restart databoard
systemctl restart caddy

# The newest three releases are kept, so a bad one can be undone by pointing /opt/databoard/app at the one before.
ls -dt /opt/databoard/releases/* | tail -n +4 | xargs -r rm -rf

ok=0
for i in $(seq 1 45); do
  if curl -fsS http://127.0.0.1:8080/api/health >/dev/null 2>&1; then ok=1; break; fi
  sleep 2
done
if [ "$ok" = 1 ]; then
  echo "DataBoard $STAMP is running."
else
  echo "DataBoard did not answer. The last lines of its log:"
  journalctl -u databoard -n 40 --no-pager
  exit 1
fi
EOS
chmod 755 /opt/databoard/configure.sh /opt/databoard/release.sh

# Nothing to run until the first release arrives; release.sh starts both services then.
